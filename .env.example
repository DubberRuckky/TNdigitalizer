# ==============================================================================
# Open Source AI Configuration (Infinite Queries Architecture)
# ==============================================================================

# Option 1: Groq Cloud API Key (Free, Infinite-speed Meta Llama 3.2 Vision)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Option 2: OpenAI / OpenRouter / Custom Open-Source Vision Provider Key
# Works with OpenRouter, Together.ai, vLLM, DeepSeek, LocalAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.groq.com/openai/v1
VISION_MODEL=llama-3.2-11b-vision-preview

# Option 3: HuggingFace API Token (Free Open Models)
# Get free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Option 4: Local Ollama (Zero keys needed, 100% offline on your Netcup VPS)
# Install on server: curl -fsSL https://ollama.com/install.sh | sh
# Run model: ollama run llama3.2-vision
OLLAMA_HOST=http://localhost:11434

# Server Configuration
PORT=8000
HOST=0.0.0.0
